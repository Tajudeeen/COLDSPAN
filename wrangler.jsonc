{
  "$schema": "node_modules/wrangler/config-schema.json",
  "name": "coldspan-api",
  "main": "cloudflare/worker.ts",
  "compatibility_date": "2026-10-26",
  "compatibility_flags": ["nodejs_compat"],
  "workers_dev": true,
  "preview_urls": false,
  "durable_objects": {
    "bindings": [
      { "name": "WORKSPACES", "class_name": "ColdspanWorkspace" },
      { "name": "REQUEST_GATES", "class_name": "ColdspanRequestGate" }
    ]
  },
  "exports": {
    "ColdspanWorkspace": { "type": "durable-object", "storage": "sqlite" },
    "ColdspanRequestGate": { "type": "durable-object", "storage": "sqlite" }
  },
  "vars": {
    "ALLOWED_ORIGIN": "https://coldspan-preview.deeen-code.chatgpt.site",
    "BUILD_ID": "coldspan-cf-20261103-4",
    "MODEL_NAME": "muse-spark-1.3",
    "MODEL_CALLS_ENABLED": "false"
  },
  "secrets": { "required": ["MODEL_API_KEY"] },
  "observability": { "enabled": true, "head_sampling_rate": 0.1 }
}
