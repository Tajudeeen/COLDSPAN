{
  "$schema": "node_modules/wrangler/config-schema.json",
  "name": "coldspan-api",
  "main": "cloudflare/deployed-worker.mjs",
  "compatibility_date": "2026-10-26",
  "compatibility_flags": ["nodejs_compat"],
  "workers_dev": true,
  "preview_urls": false,
  "durable_objects": {
    "bindings": [
      { "name": "WORKSPACES", "class_name": "ColdspanWorkspace" },
      { "name": "REQUEST_GATES", "class_name": "ColdspanRequestGate" }
    ]
  },
  "exports": {
    "ColdspanWorkspace": { "type": "durable-object", "storage": "sqlite" },
    "ColdspanRequestGate": { "type": "durable-object", "storage": "sqlite" }
  },
  "vars": {
    "ALLOWED_ORIGIN": "https://coldspan-preview.deeen-code.chatgpt.site",
    "BUILD_ID": "coldspan-cf-20261026-2"
  },
  "observability": { "enabled": true, "head_sampling_rate": 0.1 }
}
